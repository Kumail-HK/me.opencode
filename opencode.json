{
  "$schema": "https://opencode.ai/config.json",
  "theme": "catppuccin/macchiato",
  "model": "opencode-go/kimi-k2.6",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "plan",
  "autoupdate": "notify",
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "opencode-go/glm-5.1",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
          "*": "deny",
          "grep *": "allow"
        }
      }
    },
    "build": {
      "mode": "primary",
      "model": "opencode-go/kimi-k2.6",
      "temperature": 0.1,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "grep *": "allow"
        }
      }
    }
  }
}
